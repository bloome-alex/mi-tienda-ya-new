{
  "name": "mi-tienda-ya-2",
  "version": "1.19.1",
  "private": true,
  "description": "Plataforma de tiendas online PWA con Vue, Express y MongoDB",
  "type": "module",
  "workspaces": [
    "api",
    "client"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace client",
    "start": "node api/src/index.js",
    "test": "npm run test --workspace api && npm run test --workspace client",
    "check": "node scripts/check.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "migrate:r2": "node scripts/migrate-r2.mjs",
    "test:mock:subscriptions": "node --test --test-concurrency=1 scripts/test-subscriptions-mock.mjs",
    "test:mock:facebook": "node --test --test-concurrency=1 scripts/test-facebook-ads-mock.mjs",
    "test:mock:integrations": "npm run test:mock:subscriptions && npm run test:mock:facebook"
  },
  "devDependencies": {
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.1"
  }
}
