# mi-tienda-ya-2 · Copiá este archivo a .env y completá las claves vacías.
# No subas el .env real a Git ni lo incluyas en archivos compartidos.

# Aplicación. Para npm run dev usá http://localhost:5173.
# Para npm run build + npm start local usá http://localhost:5000.
# En producción: NODE_ENV=production y APP_URL=https://tu-dominio.com.
NODE_ENV=development
PORT=5000
CLIENT_PORT=5173
APP_URL=http://localhost:5173
# Usá 1 sólo si hay exactamente un proxy inverso de confianza delante.
TRUST_PROXY=0

# MongoDB standalone. En Docker Compose esta URI se genera con las variables
# MONGO_APP_* de abajo y el host interno mongo. No requiere replica set.
MONGODB_URI=mongodb://127.0.0.1:27017/mi_tienda_ya_2

# Único administrador. Acceso /root/login. Contraseña inicial obligatoria:
# mínimo 12 caracteres y máximo 72 bytes; deberá cambiarla al primer ingreso.
ROOT_USER=admin
ROOT_PASSWORD=

# Generar cada secreto con:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY: exactamente 64 caracteres hexadecimales. Conservála:
# cifra credenciales Mercado Pago y tokens de seguimiento guardados.
ENCRYPTION_KEY=
# Secreto independiente recomendado para tokens de seguimiento.
# Si está vacío, la aplicación utiliza ENCRYPTION_KEY.
SESSION_SECRET=
SESSION_DAYS=7
# bcrypt real; rango admitido 10–14.
BCRYPT_ROUNDS=12

# Correo del servidor: acceso por enlace y notificaciones de pedidos.
# Puerto 587: SMTP_SECURE=false (STARTTLS); puerto 465: true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Mi Tienda Ya <no-reply@tu-dominio.com>"

# Cantidad de minutos de reserva para pedidos Mercado Pago: 15–1440.
# Efectivo y transferencia se cancelan manualmente; no vencen por esta opción.
ORDER_RESERVATION_MINUTES=60

# Directorios persistentes. Rutas absolutas recomendadas en servidores.
# Si se dejan vacíos se usan api/data/uploads y api/data/whatsapp del proyecto.
UPLOAD_DIR=
WHATSAPP_DATA_PATH=
# Identificador único POR PROCESO/APLICACIÓN. No compartir con otra aplicación.
WHATSAPP_CLIENT_ID=mi-tienda-ya-2
# Opcional: ruta al Chromium del sistema. En Docker ya es /usr/bin/chromium.
PUPPETEER_EXECUTABLE_PATH=
# Evitar la descarga automática de navegador cuando se instala Chromium aparte.
PUPPETEER_SKIP_DOWNLOAD=true
# Activar sólo si el entorno no permite el sandbox de Chromium.
# Es preferible ejecutar con usuario sin privilegios y mantenerlo en false.
WHATSAPP_NO_SANDBOX=false

# Sólo Docker Compose: MongoDB con usuario de aplicación limitado a su base.
# Generá contraseñas hexadecimales para que puedan componerse en la URI sin escape.
MONGO_DB_NAME=mi_tienda_ya_2
MONGO_ADMIN_USER=mty_database_admin
MONGO_ADMIN_PASSWORD=
MONGO_APP_USER=mty_app
MONGO_APP_PASSWORD=
# Puerto del host sólo accesible por loopback, usado por Nginx externo.
HTTP_PORT=5000

# ENV_FILE se establece desde el proceso lanzador, no dentro de este archivo.
# Ejemplo: ENV_FILE=/ruta/absoluta/mi-tienda-ya-2/.env.tienda npm start
